{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rankboard",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",

  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rankboard-db",
      "database_id": "3e6f23da-f210-4bbc-8dfb-7d2fcdadc684"
    }
  ]
}
